# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
# One per Dart package. Listed, not a bare `.dart_tool/`, so one made by
# running dart from the wrong folder shows up in `git status`.
/.dart_tool/
/static_site_generator/.dart_tool/
/packages/*/.dart_tool/
/deprecated/web_client_prototype/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Unanchored, unlike the stock Flutter template's `/build/`: the Dart-only
# packages get one too, whenever `flutter test` is run in them by habit.
build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code local settings
.claude/settings.local.json

# Pod lock files (generated)
ios/Podfile.lock
macos/Podfile.lock

# Test helpers — only the Mockito output is generated (build_runner)
test/helpers/mocks.mocks.dart

# Node.js. research_server's lockfile is committed: `npm ci` needs it, and it
# pins wrangler for every Cloudflare deploy.
node_modules/
tools/package-lock.json

# wrangler's local cache, written at the repo root when scripts/static_site/
# deploy.sh runs from there. Holds the resolved Cloudflare account, so it is
# both regenerable and not ours to commit. (research_server/.gitignore already
# ignores its own copy.)
.wrangler/

# SQLite temporary files
*.db-shm
*.db-wal

# Generated databases (large files - regenerate with scripts)
tools/*.db
tools/*.csv
assets/databases/*.db
# Their SHA-256s, written by tools/db-finalize.js; travels with the databases
assets/databases/manifest.json

# Intermediate TTF subsets from assets/fonts/subset_fonts.sh, for the two
# Latin-only families ONLY. Those two are app-only chrome fonts: no @font-face
# rule the site generator emits ever names them, and subsetting them saves ~1KB
# total, so pubspec.yaml keeps bundling their full TTFs and these stay
# regenerable scratch.
#
# The Sinhala families are deliberately NOT ignored — pubspec.yaml bundles their
# *-Subset.ttf and the static site ships woff2 built from the same bytes, so
# they are committed build inputs. Ignoring them would break a fresh clone with
# "asset does not exist".
assets/fonts/noto-sans/*-Subset.ttf
assets/fonts/noto-serif/*-Subset.ttf
