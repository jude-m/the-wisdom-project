.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Unanchored, unlike the stock Flutter template's `/build/`: the Dart-only
# packages get one too, whenever `flutter test` is run in them by habit.
build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code local settings
.claude/settings.local.json
.claude/build/

# Pod lock files (generated)
ios/Podfile.lock
macos/Podfile.lock

# Test helpers — only the Mockito output is generated (build_runner)
test/helpers/mocks.mocks.dart

# Node.js (tools folder)
node_modules/
package-lock.json

# wrangler's local cache, written at the repo root when scripts/static_site/
# deploy.sh runs from there. Holds the resolved Cloudflare account, so it is
# both regenerable and not ours to commit. (research_server/.gitignore already
# ignores its own copy.)
.wrangler/

# SQLite temporary files
*.db-shm
*.db-wal

# Generated databases (large files - regenerate with scripts)
tools/*.db
tools/*.csv
assets/databases/*.db

# Throwaway spikes for steps 2-4 of
# docs/todo/retiring-dart-server/reduce_mobile_bundle_size.md. They produced the
# numbers in that doc's "What the measurements said" and have no job after it:
# delete both (and tools/bjt-content-spike.db, ~180 MB, already ignored above)
# once step 5 lands, and drop these three lines with them. The parts worth
# keeping move into tools/bjt-fts-populate.js, not here.
tools/bjt-content-spike.js
tools/bench_content_read.dart

# Temporary documents that should be deleted
TEST_AUDIT_REPORT.md

# Intermediate TTF subsets from assets/fonts/subset_fonts.sh, for the two
# Latin-only families ONLY. Those two are app-only chrome fonts: no @font-face
# rule the site generator emits ever names them, and subsetting them saves ~1KB
# total, so pubspec.yaml keeps bundling their full TTFs and these stay
# regenerable scratch.
#
# The Sinhala families are deliberately NOT ignored — pubspec.yaml bundles their
# *-Subset.ttf and the static site ships woff2 built from the same bytes, so
# they are committed build inputs. Ignoring them would break a fresh clone with
# "asset does not exist".
assets/fonts/noto-sans/*-Subset.ttf
assets/fonts/noto-serif/*-Subset.ttf
