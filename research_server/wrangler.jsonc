{
  "name": "wisdom-research",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Lives in the prod (ops) account only; dev builds call it too. One address:
  // the custom domain research.sammaditthi.net, attached once in the dashboard
  // (Worker -> Settings -> Domains & Routes), and no workers.dev or preview
  // URLs beside it. Not declared here as a route: that would need a zone
  // permission on the deploy token, and wrangler leaves an attached domain be.
  // Keep workers_dev off: the /research rate limit is a rule on the
  // sammaditthi.net zone, and a workers.dev address would skip it.
  "workers_dev": false,
  "preview_urls": false,
  // Dev port map: 8080 = Flutter web, 8082 = research server, 8083 = static-site
  // preview (static_site_generator/tool/serve.dart).
  "dev": {
    "port": 8082
  },
  "vars": {
    // Stub by default: a fresh deploy answers canned replies with no key.
    // Live needs RESEARCH_STUB=0 + RESEARCH_STORE here and the GEMINI_API_KEY
    // secret, which the run and deploy scripts take from
    // scripts/config/secrets.env (RESEARCH_GEMINI_API_KEY).
    "RESEARCH_STUB": "0",
    "RESEARCH_STORE": "fileSearchStores/tipitakapilotsn6-f0aqkxv2244r",
    // CORS allow-list (browser-only protection). Exact-match against the
    // browser's Origin header — scheme+host+port, NO trailing slash, NO path.
    //   localhost:8080                 = local Flutter web (scripts/app/web/run_mac.sh)
    //   app-sammaditthi-test.pages.dev = dev Flutter web (scripts/app/web/README.md)
    // Add the prod app's origin when Flutter web prod goes live.
    "RESEARCH_CORS_ORIGINS": "http://localhost:8080,https://app-sammaditthi-test.pages.dev"
  },
  // Pin the Worker to a US region so outbound Gemini calls egress from a
  // Gemini-supported location. Cloudflare's global anycast egress otherwise
  // lands some requests on IPs Google's free tier geo-blocks
  // ("User location is not supported for the API use").
  "placement": {
    "mode": "targeted",
    "region": "gcp:us-east4"
  },
  "observability": {
    "enabled": true
  }
}
