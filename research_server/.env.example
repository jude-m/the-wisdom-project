# Copy to .env and edit. The service reads these from the environment.

# --- Mode -------------------------------------------------------------
# 1/true → canned answers, NO API key and NO google-genai needed (default).
# Flip to 0 once GEMINI_API_KEY + RESEARCH_STORE are set, for real answers.
RESEARCH_STUB=1

# --- Gemini (live mode only) -----------------------------------------
GEMINI_API_KEY=
# File Search store resource name printed by the ingest job, e.g.
#   fileSearchStores/tipitaka-en-xxxxxxxx
RESEARCH_STORE=
# Generation models are grouped into the two tiers the app's Fast/Thinking switch
# chooses between; each is a fallback ladder that falls to the next rung on a 429
# (rate limit) or 503 (high demand). Built-in defaults (highest priority first):
#   FAST      gemini-3.1-flash-lite → gemini-2.5-flash-lite
#   THINKING  gemini-3.5-flash → gemini-3-flash-preview → gemini-2.5-flash
# Override a whole tier from the environment (CSV, highest priority first). Keep
# them separate so the switch still routes to two distinct ladders — a single
# global pin would leak the fast model into Thinking and defeat the switch:
# RESEARCH_FAST_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
# RESEARCH_THINKING_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash
# Optional separate (cheaper) model for the query-rewrite/translate step, which
# leads the rewrite's own fallback ladder. Rewriting is mode-independent and
# always runs on the FAST tier; unset defaults this to that tier's top model.
RESEARCH_REWRITE_MODEL=
# Optional path to a newline-delimited list of real uids. When present, the
# linkifier drops refs that aren't in it (design §11.9). Emit it from ingest.
RESEARCH_UID_MANIFEST=
# Max characters for each Sources snippet (the windowed preview around the match).
RESEARCH_SNIPPET_CHARS=220

# --- Service ----------------------------------------------------------
# Comma-separated allowed CORS origins, or * for any (dev only).
RESEARCH_CORS_ORIGINS=*
# Optional shared secret. If set, callers must send header X-App-Token with it.
RESEARCH_APP_TOKEN=
# Local dev port (8080 is the Dart web content server). Cloud Run injects PORT.
PORT=8081

# --- Ingest -----------------------------------------------------------
# Local checkout of github.com/suttacentral/bilara-data (published branch).
BILARA_DATA_DIR=../bilara-data
