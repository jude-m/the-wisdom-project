<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher; backup_rules.xml says why. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="databases/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="databases/" />
    </device-transfer>
</data-extraction-rules>
