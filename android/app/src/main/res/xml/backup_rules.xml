<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. The bundled database copies are rebuilt from the app
     package, and they would push the backup past its 25 MB limit, which skips
     the whole backup. See local_database_executor_native.dart. -->
<full-backup-content>
    <exclude domain="file" path="databases/" />
</full-backup-content>
