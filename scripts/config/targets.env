# Where every product deploys: projects, branches, origins, URLs. Committed, so
# a fresh clone and CI agree. No secret goes here — those are in secrets.env.
#
# Read one key at a time with `target NAME` (scripts/lib/common.sh). Deploy
# scripts take the value from this file only; an exported variable of the same
# name does not change where a deploy goes.

# Two Cloudflare accounts: dev (wisdomproject.dev) and prod (ops). Anything
# paid — the research Worker, the R2 bucket — lives in prod only and dev builds
# use it too; the dev account holds only free Pages projects.

# Static site. Each target's account, project and branch are right or wrong
# together — see scripts/static_site/deploy.sh. Both branches are their
# project's production branch; PROD_BRANCH is also the git branch a release
# must be cut from.
STATIC_SITE_DEV_PROJECT=sammaditthi-test
STATIC_SITE_DEV_BRANCH=main
STATIC_SITE_PROD_PROJECT=sammaditthi
STATIC_SITE_PROD_BRANCH=main
STATIC_SITE_PROD_ORIGIN=https://sammaditthi.net

# The research Worker: prod only, and every build calls it (see
# scripts/research_server/deploy.sh). The run scripts' default; an exported
# value wins there. The domain is attached to the Worker in the dashboard
# (scripts/research_server/README.md), not declared in wrangler.jsonc.
RESEARCH_BASE_URL=https://research.sammaditthi.net
# The git branch a research release must be cut from.
RESEARCH_PROD_BRANCH=main

# The databases: one R2 bucket in prod, read by every web build, as
# <base>/<db>-<sha16>.db.gz. The domain is attached to the bucket in the
# dashboard (scripts/app/web/README.md).
DATABASE_BUCKET=wisdom-databases
DATABASE_BASE_URL=https://db.sammaditthi.net

# The app on the web (scripts/app/web/deploy.sh). Dev only for now; prod will
# be app.sammaditthi.net. The branch is the project's production branch.
APP_WEB_DEV_PROJECT=app-sammaditthi-test
APP_WEB_DEV_BRANCH=main
# Where a prod static build's "read in the app" links point. Set before the prod
# app project exists (2026-10-05), so those links answer nothing until it does.
APP_WEB_PROD_ORIGIN=https://app.sammaditthi.net
